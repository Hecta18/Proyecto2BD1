generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empleado {
  id_empleado Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(120)
  activo      Boolean  @default(true)
  clientes    Cliente[]
  compras     Compra[]

  @@map("empleado")
}

model Categoria {
  id_categoria Int    @id @default(autoincrement())
  nombre       String @db.VarChar(100)

  @@map("categoria")
}

model Proveedor {
  id_proveedor Int     @id @default(autoincrement())
  nombre       String  @db.VarChar(160)
  contacto     String? @db.VarChar(200)

  @@map("proveedor")
}

model Producto {
  id_producto  Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(200)
  precio_venta Decimal  @db.Decimal(12, 2)
  stock        Int      @default(0)
  activo       Boolean  @default(true)
  detalles     Detalle[]

  @@map("producto")
}

model Cliente {
  id_cliente  Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(160)
  email       String?  @db.VarChar(180)
  telefono    String?  @db.VarChar(40)
  id_empleado Int
  empleado    Empleado @relation(fields: [id_empleado], references: [id_empleado])
  compras     Compra[]

  @@map("cliente")
}

model Compra {
  id_compra     Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  id_cliente    Int
  id_empleado   Int
  observaciones String?  @db.VarChar(500)
  cliente       Cliente  @relation(fields: [id_cliente], references: [id_cliente])
  empleado      Empleado @relation(fields: [id_empleado], references: [id_empleado])
  factura       Factura?

  @@map("compra")
}

model Factura {
  id_factura    Int       @id @default(autoincrement())
  id_compra     Int       @unique
  fecha_emision DateTime  @db.Date
  estado        String    @default("emitida") @db.VarChar(20)
  compra        Compra    @relation(fields: [id_compra], references: [id_compra])
  detalles      Detalle[]

  @@map("factura")
}

model Detalle {
  id_detalle      Int      @id @default(autoincrement())
  id_factura      Int
  id_producto     Int
  cantidad        Int
  precio_unitario Decimal  @db.Decimal(12, 2)
  subtotal        Decimal  @db.Decimal(12, 2)
  factura         Factura  @relation(fields: [id_factura], references: [id_factura])
  producto        Producto @relation(fields: [id_producto], references: [id_producto])

  @@map("detalle")
}

model UsuarioApp {
  id_usuario    Int     @id @default(autoincrement())
  username      String  @unique @db.VarChar(80)
  password_hash String
  rol_db        String  @db.VarChar(80)
  nombre        String  @db.VarChar(120)
  activo        Boolean @default(true)

  @@map("usuario_app")
}
